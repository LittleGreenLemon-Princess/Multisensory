{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LittleGreenLemon-Princess/Multisensory/schemas/canonical-skill-v1",
  "title": "Canonical multisensory skill",
  "type": "object",
  "required": ["schema", "id", "version", "title", "vertical_capability", "goal", "implementation_refs", "supporting_instance_ids", "signal_contract", "preconditions", "stop_conditions", "known_failures", "evidence_refs", "status"],
  "properties": {
    "schema": {"const": "multisensory-canonical-skill-v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "vertical_capability": {"enum": ["localization", "grasp", "transport", "manipulation", "long-horizon"]},
    "goal": {"type": "string", "minLength": 1},
    "implementation_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "supporting_instance_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "signal_contract": {"type": "object"},
    "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "known_failures": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["candidate", "validated", "retired"]}
  }
}
