{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LittleGreenLemon-Princess/Multisensory/schemas/principle-v1",
  "title": "Evidence-grounded skill principle",
  "type": "object",
  "required": ["schema", "id", "version", "title", "vertical_capability", "when", "decision", "invariant", "expected_effects", "exceptions", "falsifiers", "supporting_skill_ids", "signal_contract", "evidence_refs", "status"],
  "properties": {
    "schema": {"const": "multisensory-principle-v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "vertical_capability": {"enum": ["localization", "grasp", "transport", "manipulation", "long-horizon"]},
    "when": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "invariant": {"type": "string", "minLength": 1},
    "expected_effects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exceptions": {"type": "array", "items": {"type": "string"}},
    "falsifiers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "supporting_skill_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "signal_contract": {"type": "object"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["candidate", "validated", "retired"]}
  }
}
